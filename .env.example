# Copy to .env and fill in fresh keys: `theraflo-ads gen-keys`
THERAFLO_ADS_ENV=development
THERAFLO_ADS_BACKEND=infra
THERAFLO_ADS_DATABASE_URL=postgresql+pg8000://theraflo:theraflo@127.0.0.1:5432/theraflo_ads
THERAFLO_ADS_REDIS_URL=redis://127.0.0.1:6379/0
THERAFLO_ADS_AMQP_URL=amqp://theraflo:theraflo@127.0.0.1:5672/%2F
THERAFLO_ADS_LAKE_PATH=data/lake
THERAFLO_ADS_USER_HASH_KEY=
THERAFLO_ADS_TOKEN_KEY=
THERAFLO_ADS_SESSION_KEY=

# Operations
THERAFLO_ADS_LOG_FORMAT=text          # json in containers
THERAFLO_ADS_LOG_LEVEL=INFO
THERAFLO_ADS_RATE_LIMITS=on           # off only for load tests
THERAFLO_ADS_METRICS_TOKEN=           # set to require a bearer token on /metrics
THERAFLO_ADS_AUTH_FALLBACK_HEADER=off # on only behind a proxy that deletes Authorization (LocalStack Container Apps)
THERAFLO_ADS_CATALOG_REFRESH_S=5

# Creative review (Phase 8). `ollama` is a local model (free); `anthropic` calls Claude and
# is billed per call.
THERAFLO_ADS_REVIEWER=none            # none | simulated | ollama | anthropic
THERAFLO_ADS_NARRATOR=none            # none (templates) | ollama | anthropic
ANTHROPIC_API_KEY=
THERAFLO_ADS_OLLAMA_URL=http://127.0.0.1:11434   # compose default: http://host.docker.internal:11434
THERAFLO_ADS_OLLAMA_MODEL=qwen3.5:9b
THERAFLO_ADS_OLLAMA_THINK=false       # true: reason before answering (slower)
